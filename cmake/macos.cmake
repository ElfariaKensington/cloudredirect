set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
enable_language(C OBJCXX)
set(DOBBY_DEBUG OFF CACHE BOOL "" FORCE)
set(Plugin.SymbolResolver ON CACHE BOOL "" FORCE)
add_subdirectory(vendor/dobby EXCLUDE_FROM_ALL)
if(NOT CMAKE_OSX_ARCHITECTURES)
    set(CMAKE_OSX_ARCHITECTURES arm64)
endif()
set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
list(REMOVE_ITEM COMMON_SOURCES src/common/steam_kv_injector.cpp)
file(GLOB MAC_SOURCES CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/src/platform/macos/*.cpp")
list(REMOVE_ITEM MAC_SOURCES "${CMAKE_SOURCE_DIR}/src/platform/macos/cloud760_tool.cpp")
# The native ARM64 transport replaces the Linux/x86 hooks.

add_library(cloud_redirect SHARED ${COMMON_SOURCES} ${PROVIDER_SOURCES} ${MAC_SOURCES})
target_include_directories(cloud_redirect PRIVATE src/platform/macos src/common src/providers vendor/dobby/include)
target_compile_definitions(cloud_redirect PRIVATE MINIZ_NO_STDIO CR_VERSION_STRING="${CR_SO_VERSION}" CR_RELEASE_VERSION="${CR_RELEASE_VERSION}")
target_link_libraries(cloud_redirect PRIVATE dobby_static curl "-framework CoreFoundation" "-framework Security")
target_link_libraries(cloud_redirect PRIVATE dobby_symbol_resolver macho_ctx_kit shared_cache_ctx_kit osbase)
set_target_properties(cloud_redirect PROPERTIES PREFIX "" INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_NAME_DIR TRUE)
add_executable(cloud_redirect_cli src/platform/macos/cli_main.mm)
target_include_directories(cloud_redirect_cli PRIVATE src/platform/macos src/common)
target_link_libraries(cloud_redirect_cli PRIVATE cloud_redirect "-framework Foundation" "-framework Security")
set_target_properties(cloud_redirect_cli PROPERTIES BUILD_RPATH "@loader_path" INSTALL_RPATH "@loader_path" BUILD_WITH_INSTALL_RPATH TRUE)
enable_testing()
add_executable(macos_core_tests tests/macos_core_tests.cpp)
target_include_directories(macos_core_tests PRIVATE src/platform/macos src/common src/providers vendor/dobby/include)
target_link_libraries(macos_core_tests PRIVATE cloud_redirect)
add_test(NAME macos_core_tests COMMAND macos_core_tests)
target_link_libraries(macos_core_tests PRIVATE curl)
add_executable(pending_ops_journal_tests tests/pending_ops_journal_tests.cpp)
target_include_directories(pending_ops_journal_tests PRIVATE src/platform/macos src/common)
target_link_libraries(pending_ops_journal_tests PRIVATE cloud_redirect)
add_test(NAME pending_ops_journal_tests COMMAND pending_ops_journal_tests)
# Optional integration check: requires a compatible, installed ARM64 Steam client.
add_executable(macos_native_rpc_tests tests/macos_native_rpc_tests.cpp)
target_include_directories(macos_native_rpc_tests PRIVATE src/platform/macos src/common)
target_link_libraries(macos_native_rpc_tests PRIVATE cloud_redirect)

set_tests_properties(macos_core_tests pending_ops_journal_tests PROPERTIES TIMEOUT 30)
add_executable(macos_stats_tests tests/macos_stats_tests.cpp)
target_include_directories(macos_stats_tests PRIVATE src/platform/macos src/common)
target_link_libraries(macos_stats_tests PRIVATE cloud_redirect)
add_test(NAME macos_stats_tests COMMAND macos_stats_tests)
set_tests_properties(macos_stats_tests PROPERTIES TIMEOUT 30)

add_executable(cloud760_tool src/platform/macos/cloud760_tool.cpp)
add_executable(macos_manifest_tests tests/macos_manifest_tests.cpp)
target_include_directories(macos_manifest_tests PRIVATE src/platform/macos src/common)
target_link_libraries(macos_manifest_tests PRIVATE cloud_redirect)
add_test(NAME macos_manifest_tests COMMAND macos_manifest_tests)
set_tests_properties(macos_manifest_tests PROPERTIES TIMEOUT 30)
add_executable(macos_lua_tests tests/macos_lua_tests.cpp)
target_include_directories(macos_lua_tests PRIVATE src/platform/macos src/common)
target_link_libraries(macos_lua_tests PRIVATE cloud_redirect)
add_test(NAME macos_lua_tests COMMAND macos_lua_tests)
set_tests_properties(macos_lua_tests PROPERTIES TIMEOUT 30)
